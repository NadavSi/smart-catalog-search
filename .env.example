# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# Generate with: openssl rand -base64 24
DB_PASSWORD=

# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

APP_NAME="Smart Catalog Search"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8095
APP_LOCALE=he
APP_PORT=8095

LOG_CHANNEL=stderr
LOG_LEVEL=warning
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Each Octane worker holds its own copy of the model (~1.1GB).
OCTANE_WORKERS=1

# Cross-encoder re-ranking (bge-reranker-v2-m3). Off by default: ~7s per
# search on CPU and ~1.2GB more per worker. See README "Re-ranking".
SEARCH_RERANK=false
